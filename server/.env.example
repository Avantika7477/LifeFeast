PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/lifequest
# Production (Atlas): mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lifequest?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
# Web Push (npx web-push generate-vapid-keys). Needed for closed-app phone pings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional. If set, POST /api/notifications/push-reminders must send x-cron-secret.
CRON_SECRET=
